<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.1.4</Version>
    <Author>kaldigo</Author>
    <PackageProjectUrl>https://github.com/kaldigo/FFXIVAetherworks</PackageProjectUrl>
    <Name>Aetherworks</Name>
    <Punchline>Paid Return fallback, shared hotbar sync and saddlebag conveniences.</Punchline>
    <Description>Teleport home while Return is on cooldown, sync shared hotbars between PvE and PvP, and withdraw saddlebag stacks while leaving one for easy duplicate entrusting. Each feature is independently enabled.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AetherglassUIProject Condition="'$(AetherglassUIProject)' == '' and Exists('../.dependencies/AetherglassUI/Library/AetherglassUI.csproj')">../.dependencies/AetherglassUI/Library/AetherglassUI.csproj</AetherglassUIProject>
    <AetherglassUIProject Condition="'$(AetherglassUIProject)' == '' and Exists('../../../AetherglassUI/Library/AetherglassUI.csproj')">../../../AetherglassUI/Library/AetherglassUI.csproj</AetherglassUIProject>
    <AetherglassUIProject Condition="'$(AetherglassUIProject)' == ''">../../AetherglassUI/Library/AetherglassUI.csproj</AetherglassUIProject>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(AetherglassUIProject)" /></ItemGroup>
  <ItemGroup>
    <Reference Include="TerraFX.Interop.Windows" HintPath="$(DalamudLibPath)TerraFX.Interop.Windows.dll" Private="false" />
    <Reference Include="Browsingway.Common" HintPath="../vendor/Browsingway/Browsingway.Common.dll" Private="true" />
    <Reference Include="FlatSharp.Runtime" HintPath="../vendor/Browsingway/FlatSharp.Runtime.dll" Private="true" />
    <Reference Include="SharedMemory" HintPath="../vendor/Browsingway/SharedMemory.dll" Private="true" />
    <Content Include="Ember/ember.html" Link="ember.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../vendor/Browsingway/renderer/*" Link="renderer/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
